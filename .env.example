# Strava API credentials — register your app at https://www.strava.com/settings/api
# Set Authorization Callback Domain to: localhost (dev) or add-stifa.info (prod)

# Used by the Netlify serverless function (server-side only, never exposed to browser)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# Used by the browser to build the Strava OAuth authorization URL (safe to expose)
VITE_STRAVA_CLIENT_ID=your_client_id
